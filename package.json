{
  "name": "dsh-conversation-search",
  "version": "1.0.0",
  "description": "在当前对话内按关键词搜索历史消息：既能找到你发过的提示词，也能找到模型当时的回复",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "search",
    "conversation",
    "chat",
    "plugin"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xtzqhy/dsh-conversation-search.git"
  },
  "homepage": "https://github.com/xtzqhy/dsh-conversation-search#readme",
  "bugs": {
    "url": "https://github.com/xtzqhy/dsh-conversation-search/issues"
  },
  "author": "xtzqhy",
  "type": "module",
  "main": "index.js",
  "icon": "./icon.svg",
  "license": "MIT",
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale",
    "docs",
    "icon.svg",
    "README.md",
    "assets",
    "LICENSE"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "engines": {
    "dsh": ">=0.2.2-rc.1 <0.2.3-0"
  }
}
